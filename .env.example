# ---------------------------------------------------------------------------
# Workloom configuration
#
# Copy to .env and fill in. The application validates every variable at
# startup and refuses to boot with a message naming each problem.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Public origin this instance is served from. Used for links in outbound email.
APP_URL=http://localhost:3000

# --- Tenancy ---------------------------------------------------------------
# false (the default): one agency, one organization. There is no public
# sign-up -- open the app once it is running and the setup screen creates the
# administrator and the organization. Every account after that is created by
# an administrator under Settings -> Members.
#
# true: anyone may sign up and create their own organization, which is what a
# hosted installation serving several agencies needs. Organizations are
# isolated from each other by row-level security either way.
MULTI_TENANT=false

# --- Database --------------------------------------------------------------
# Must NOT be a superuser: PostgreSQL superusers bypass row-level security,
# which is what isolates one organization's data from another's. The bundled
# docker-compose creates an unprivileged `workloom_app` role for this.
DATABASE_URL=postgres://workloom_app:workloom_dev_password@localhost:5432/workloom
DATABASE_POOL_SIZE=10

# --- Secrets ---------------------------------------------------------------
# Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts webhook signing secrets and integration credentials at rest.
# Losing this makes those secrets unrecoverable. Back it up.
WORKLOOM_ENCRYPTION_KEY=
# After rotating WORKLOOM_ENCRYPTION_KEY, list the old key(s) here, comma-separated,
# so existing secrets stay readable.
#WORKLOOM_PREVIOUS_ENCRYPTION_KEYS=

# --- Email -----------------------------------------------------------------
# Defaults target the Mailpit container from docker-compose.dev.yml (UI :8025).
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
MAIL_FROM=workloom@example.com

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-data
# When STORAGE_DRIVER=s3, these are required:
#S3_ENDPOINT=http://localhost:9000
#S3_REGION=us-east-1
#S3_BUCKET=workloom
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=true

# --- Optional --------------------------------------------------------------
# Queues and rate limiting run on Postgres by default. Setting REDIS_URL
# switches them to Redis, which is worth it only at larger scale.
#REDIS_URL=redis://localhost:6379

# Allow webhook delivery to private/loopback addresses. Off by default because
# Workloom usually runs inside a private network, where such a URL is an SSRF
# vector against internal services. Enable only for local testing.
#WORKLOOM_ALLOW_PRIVATE_WEBHOOKS=false
