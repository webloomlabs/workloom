# The web application: the user interface, the REST API, and migrations on boot.
#
# Built in three stages so the runtime image carries neither the package manager
# nor the sources -- only the traced server output Next produces.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS deps
WORKDIR /repo
# Only what pnpm needs to resolve, so a source edit does not reinstall.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/emails/package.json packages/emails/
COPY packages/pdf/package.json packages/pdf/
COPY packages/storage/package.json packages/storage/
COPY packages/ui/package.json packages/ui/
COPY tests/e2e/package.json tests/e2e/
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY . .
# `next build` collects page data, which loads the configuration schema, which
# refuses to start on anything invalid. So the build is given a valid-looking
# configuration: the shipped example plus two placeholder secrets. None of it
# survives into the runtime image, and every value is read again from the real
# environment when the container starts.
#
# .dockerignore keeps the developer's own .env out of the build context, so
# this file is the only one there is.
ENV NODE_ENV=production \
    BETTER_AUTH_SECRET=build-time-placeholder-not-a-real-secret \
    WORKLOOM_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RUN cp .env.example .env && pnpm --filter @workloom/web exec next build && rm .env

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
# Never root: a container that is compromised should not also be privileged.
RUN addgroup -g 1001 workloom && adduser -u 1001 -G workloom -S workloom

COPY --from=build --chown=workloom:workloom /repo/apps/web/.next/standalone ./
COPY --from=build --chown=workloom:workloom /repo/apps/web/.next/static ./apps/web/.next/static
# Data files, not modules, so nothing traced them: the fonts a document is
# rendered with, and the migrations the app applies on boot. Both are found
# through the environment variables set below.
COPY --from=build --chown=workloom:workloom /repo/packages/pdf/fonts ./packages/pdf/fonts
COPY --from=build --chown=workloom:workloom /repo/packages/db/src/migrations ./packages/db/migrations
ENV WORKLOOM_FONT_DIR=/app/packages/pdf/fonts \
    WORKLOOM_MIGRATIONS_DIR=/app/packages/db/migrations

# Attachments live here. Created and owned in the image on purpose: Docker
# seeds a fresh named volume from the image's directory, ownership included, so
# without this the volume belongs to root and the unprivileged app cannot write
# a single upload to it.
RUN mkdir -p /data/storage && chown -R workloom:workloom /data
USER workloom
EXPOSE 3000
# Compose waits on this before starting anything that depends on the app.
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
